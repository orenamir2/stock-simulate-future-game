{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventModelMetadata", "companyEvents", "scenarios", "signals"],
  "properties": {
    "eventModelMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathGeneration", "inputProbabilityKind", "outputProbabilityKind", "calibrationMethod"],
      "properties": {
        "pathGeneration": { "type": "string", "enum": ["enumerated", "sampled"] },
        "inputProbabilityKind": { "type": "string", "const": "elicited-conditional-assumptions" },
        "outputProbabilityKind": { "type": "string", "const": "evidence-calibrated-path-probabilities" },
        "calibrationMethod": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "companyEvents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "dateWindow", "prerequisiteIds", "states", "conditionalLikelihoods", "evidenceSourceIds", "unknowns"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "dateWindow": {
            "type": "object",
            "additionalProperties": false,
            "required": ["earliest", "latest"],
            "properties": {
              "earliest": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "latest": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          },
          "prerequisiteIds": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
          "states": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "outcome", "prerequisiteStateIds", "incompatibleStateIds", "revenueImpacts"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 80 },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "outcome": { "type": "string", "enum": ["occurs", "does-not-occur"] },
                "prerequisiteStateIds": { "type": "array", "maxItems": 40, "items": { "type": "string", "pattern": "^[^:]+:[^:]+$" } },
                "incompatibleStateIds": { "type": "array", "maxItems": 40, "items": { "type": "string", "pattern": "^[^:]+:[^:]+$" } },
                "revenueImpacts": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["exposureId", "impactPct"],
                    "properties": {
                      "exposureId": { "type": "string", "minLength": 1, "maxLength": 100 },
                      "impactPct": { "type": "number", "minimum": -100, "maximum": 300 }
                    }
                  }
                }
              }
            }
          },
          "conditionalLikelihoods": {
            "type": "array",
            "minItems": 2,
            "maxItems": 40,
            "description": "For each distinct givenStateIds set, include exactly one row for every state of this event; each complete set must sum to 1.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stateId", "givenStateIds", "likelihood", "basis", "evidenceSourceIds", "unknowns"],
              "properties": {
                "stateId": { "type": "string", "minLength": 1, "maxLength": 80 },
                "givenStateIds": { "type": "array", "maxItems": 40, "items": { "type": "string", "pattern": "^[^:]+:[^:]+$" } },
                "likelihood": { "type": "number", "minimum": 0, "maximum": 1 },
                "basis": { "type": "string", "enum": ["elicited-assumption", "calibrated-probability"] },
                "evidenceSourceIds": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
                "unknowns": { "type": "array", "maxItems": 12, "items": { "type": "string" } }
              }
            }
          },
          "evidenceSourceIds": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
          "unknowns": { "type": "array", "maxItems": 12, "items": { "type": "string" } }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "thesis", "relativeLikelihood", "probabilityRationale", "valuationMethod", "factorStates", "eventPath", "valuationInputs", "keyDrivers", "sourceIds"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "thesis": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "relativeLikelihood": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
          "probabilityRationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "valuationMethod": { "type": "string", "minLength": 1, "maxLength": 300 },
          "factorStates": {
            "type": "object",
            "additionalProperties": false,
            "required": ["macro", "industryDemand", "companyExecution", "valuationRegime", "balanceSheet"],
            "properties": {
              "macro": { "type": "string", "enum": ["downturn", "steady", "expansion"] },
              "industryDemand": { "type": "string", "enum": ["contraction", "steady", "growth"] },
              "companyExecution": { "type": "string", "enum": ["miss", "meet", "beat"] },
              "valuationRegime": { "type": "string", "enum": ["compression", "steady", "expansion"] },
              "balanceSheet": { "type": "string", "enum": ["deteriorating", "steady", "improving"] }
            }
          },
          "eventPath": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["eventId", "stateId", "occursOn"],
              "properties": {
                "eventId": { "type": "string", "minLength": 1, "maxLength": 80 },
                "stateId": { "type": "string", "minLength": 1, "maxLength": 80 },
                "occursOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            }
          },
          "valuationInputs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revenueCagrPct", "operatingMarginPct", "freeCashFlowMarginPct", "netIncomeMarginPct", "balanceSheetValue", "netCash", "dilutedShares", "reportingToTradingFxRate", "valuationBasis", "valuationMetric", "valuationMultiple", "cumulativeDividendsPerShare"],
            "properties": {
              "revenueCagrPct": { "type": "number", "minimum": -100, "maximum": 300 },
              "operatingMarginPct": { "type": "number", "minimum": -100, "maximum": 100 },
              "freeCashFlowMarginPct": { "type": "number", "minimum": -100, "maximum": 100 },
              "netIncomeMarginPct": { "type": "number", "minimum": -100, "maximum": 100 },
              "balanceSheetValue": { "type": "number", "minimum": 0, "maximum": 1000000000 },
              "netCash": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
              "dilutedShares": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000 },
              "reportingToTradingFxRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
              "valuationBasis": { "type": "string", "enum": ["enterprise-value-multiple", "equity-value-multiple", "nav"] },
              "valuationMetric": { "type": "string", "enum": ["revenue", "ebit", "free-cash-flow", "net-income", "book-value", "nav"] },
              "valuationMultiple": { "type": "number", "minimum": 0, "maximum": 200 },
              "cumulativeDividendsPerShare": { "type": "number", "minimum": 0, "maximum": 1000000 }
            }
          },
          "keyDrivers": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
          "sourceIds": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } }
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value", "tone", "detail"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "value": { "type": "string", "minLength": 1, "maxLength": 100 },
          "tone": { "type": "string", "enum": ["good", "neutral", "bad"] },
          "detail": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
