{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticker", "company", "currentPrice", "expectedPrice", "summary", "scenarios", "signals", "research", "sources"],
  "properties": {
    "ticker": { "type": "string" },
    "company": { "type": "string" },
    "currentPrice": { "type": "number", "exclusiveMinimum": 0 },
    "expectedPrice": { "type": "number", "minimum": 0 },
    "summary": { "type": "string" },
    "scenarios": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "probability", "price", "thesis", "type", "targetEquityValue", "targetDilutedShares", "valuationMethod", "keyDrivers", "sourceIds"],
        "properties": {
          "name": { "type": "string" },
          "probability": { "type": "integer", "minimum": 0, "maximum": 100 },
          "price": { "type": "number", "minimum": 0 },
          "thesis": { "type": "string" },
          "type": { "type": "string", "enum": ["bull", "base", "bear"] },
          "targetEquityValue": { "type": "number", "minimum": 0 },
          "targetDilutedShares": { "type": "number", "exclusiveMinimum": 0 },
          "valuationMethod": { "type": "string" },
          "keyDrivers": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string" } },
          "sourceIds": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } }
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value", "tone", "detail"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "tone": { "type": "string", "enum": ["good", "neutral", "bad"] },
          "detail": { "type": "string" }
        }
      }
    },
    "research": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["categoryId", "score", "evidenceStrength", "finding", "unansweredQuestions", "sourceIds"],
        "properties": {
          "categoryId": { "type": "string" },
          "score": { "type": "integer", "minimum": -2, "maximum": 2 },
          "evidenceStrength": { "type": "integer", "minimum": 0, "maximum": 3 },
          "finding": { "type": "string" },
          "unansweredQuestions": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
          "sourceIds": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 8,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "publishedAt", "url", "type", "primary"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "publishedAt": { "type": "string" },
          "url": { "type": "string" },
          "type": { "type": "string", "enum": ["filing", "company", "regulator", "government", "industry", "competitor", "customer", "market", "news"] },
          "primary": { "type": "boolean" }
        }
      }
    }
  }
}
